# Copy to .env in this repository on the management laptop; chmod 600 .env.
# Generate each password separately with: openssl rand -hex 16
# Both passwords are required. Keep the administrator password private.

ADMIN_PASSWORD=

# Share this password with players.
SERVER_PASSWORD=

# Optional bearer token for the read-only status API (compose.yaml `api` service).
# Only needed if the API is ever exposed beyond localhost; also uncomment the
# API_TOKEN line in compose.yaml.
# API_TOKEN=

# Cloudflare Tunnel token for the cloudflared service (Zero Trust dashboard
# -> Networks -> Tunnels). Required to run the cloudflared service.
TUNNEL_TOKEN=
