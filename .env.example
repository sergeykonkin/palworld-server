# Copy to .env on the server (/d/palworld/.env), chmod 600, owned by root.
# Generate with: openssl rand -base64 18 | tr -d '/+=' | cut -c1-20

ADMIN_PASSWORD=changeme

# Empty = no password to join. Safe only while the server stays LAN-only
# (COMMUNITY=false and no port forwarding). Set one before opening 8211 up.
SERVER_PASSWORD=
